---
import '@fontsource-variable/geist/wght';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { CURRENCIES } from '../lib/format';
import { nextStep } from '../lib/stages';
import { searchIndex } from '../lib/search';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const next = nextStep(path);
const fullTitle = title === 'Hobo Finance' ? title : `${title} | Hobo Finance`;
const canonical = new URL(path, Astro.site);
const posts = await getCollection('blog', (p) => !p.data.draft);
const index = searchIndex(posts.map((p) => ({ href: `/blog/${p.id}/`, title: p.data.title, description: p.data.description })));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0f1b3d" />
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('hf-theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#1d4ed8"></rect><path d="M10 8h3.6v6.4h4.8V8H22v16h-3.6v-6.4h-4.8V24H10z" fill="#fff"></path></svg>
          Hobo Finance
        </a>
        <nav aria-label="Main">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Start here</a>
          <a href="/tools/" aria-current={path.startsWith('/tools') ? 'page' : undefined}>Tools</a>
          <a href="/calculators/" aria-current={path.startsWith('/calculators') ? 'page' : undefined}>Basics</a>
          <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
        </nav>
        <div class="search">
          <input id="site-search" type="search" placeholder="Search calculators and tools" autocomplete="off" role="combobox" aria-label="Search this site" aria-controls="search-results" aria-expanded="false" />
          <ul class="search-results" id="search-results" role="listbox" hidden></ul>
          <script type="application/json" id="search-index" set:html={JSON.stringify(index)} />
        </div>
        <label class="currency">
          <span>Currency</span>
          <select id="currency">
            {CURRENCIES.map((c) => <option value={c}>{c}</option>)}
          </select>
        </label>
        <button class="theme-toggle" id="theme-toggle" type="button">Dark mode</button>
      </div>
    </header>

    <main>
      <slot />
      {
        next && (
          <nav class="wrap next-step" aria-label="Next step">
            <p>
              Next: <a href={next.href}>{next.question}</a>
            </p>
            <p class="note">
              {next.title}. Or see <a href="/">every step</a>.
            </p>
          </nav>
        )
      }
    </main>

    <footer class="site-foot">
      <div class="wrap flow">
        <p>
          <strong>Not financial advice.</strong> This is general information for people in Singapore. Results are
          estimates from your numbers and past market data. Past data does not predict the future. Check important
          decisions with a licensed adviser.
        </p>
        <p>Nothing you type leaves your device. Inputs are saved in this browser only.</p>
        <div class="foot-actions">
          <button class="btn" id="export-inputs" type="button">Export my inputs</button>
          <button class="btn" id="import-inputs" type="button">Import my inputs</button>
          <input id="import-file" type="file" accept="application/json,.json" hidden />
          <span id="io-status" role="status"></span>
        </div>
      </div>
    </footer>

    <script>
      import { getCurrency, setCurrency } from '../lib/format';
      import { search, type SearchItem } from '../lib/search';
      const select = document.querySelector<HTMLSelectElement>('#currency');
      if (select) {
        select.value = getCurrency();
        select.addEventListener('change', () => setCurrency(select.value));
      }

      // Site search: matches the typed words against a list of every page.
      const box = document.querySelector<HTMLInputElement>('#site-search');
      const list = document.querySelector<HTMLUListElement>('#search-results');
      if (box && list) {
        const items: SearchItem[] = JSON.parse(document.querySelector('#search-index')?.textContent ?? '[]');
        let active = -1;
        const close = () => {
          list.hidden = true;
          box.setAttribute('aria-expanded', 'false');
          active = -1;
        };
        const mark = () => list.querySelectorAll('li[role="option"]').forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
        const render = () => {
          const q = box.value.trim();
          if (!q) return close();
          const hits = search(items, q);
          list.replaceChildren();
          if (hits.length === 0) {
            const li = document.createElement('li');
            li.className = 'empty';
            li.textContent = 'No page matches. Try a shorter word, such as “loan” or “CPF”.';
            list.append(li);
          }
          for (const h of hits) {
            const li = document.createElement('li');
            li.setAttribute('role', 'option');
            const a = document.createElement('a');
            a.href = h.href;
            const t = document.createElement('strong');
            t.textContent = h.title;
            const d = document.createElement('span');
            d.textContent = h.text;
            a.append(t, d);
            li.append(a);
            list.append(li);
          }
          active = -1;
          list.hidden = false;
          box.setAttribute('aria-expanded', 'true');
        };
        box.addEventListener('input', render);
        box.addEventListener('focus', render);
        box.addEventListener('keydown', (e) => {
          const links = list.querySelectorAll<HTMLAnchorElement>('li[role="option"] a');
          if (e.key === 'Escape') {
            close();
          } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            if (links.length === 0) return;
            e.preventDefault();
            active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
            mark();
          } else if (e.key === 'Enter' && links.length > 0) {
            e.preventDefault();
            location.href = links[Math.max(active, 0)].href;
          }
        });
        document.addEventListener('click', (e) => {
          if (!(e.target as Element).closest('.search')) close();
        });
      }

      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const paint = () => {
        if (toggle) toggle.textContent = document.documentElement.dataset.theme === 'dark' ? 'Light mode' : 'Dark mode';
      };
      paint();
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('hf-theme', next);
        } catch {}
        paint();
      });

      // Export and import everything this site has saved in the browser.
      const status = document.querySelector<HTMLElement>('#io-status')!;
      const file = document.querySelector<HTMLInputElement>('#import-file')!;
      const ours = (k: string) => k.startsWith('hf:') || k.startsWith('hf-');
      document.querySelector('#export-inputs')?.addEventListener('click', () => {
        const data: Record<string, string> = {};
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i)!;
            if (ours(k)) data[k] = localStorage.getItem(k)!;
          }
        } catch {
          status.textContent = 'This browser is blocking saved data, so there is nothing to export.';
          return;
        }
        const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = 'hobofinance-inputs.json';
        a.click();
        URL.revokeObjectURL(url);
        status.textContent = 'Exported ' + Object.keys(data).length + ' saved items.';
      });
      document.querySelector('#import-inputs')?.addEventListener('click', () => file.click());
      file.addEventListener('change', async () => {
        const f = file.files?.[0];
        if (!f) return;
        try {
          const data = JSON.parse(await f.text());
          if (typeof data !== 'object' || data === null || Array.isArray(data)) throw new Error('shape');
          let n = 0;
          for (const [k, v] of Object.entries(data)) {
            if (ours(k) && typeof v === 'string') {
              localStorage.setItem(k, v);
              n++;
            }
          }
          if (n === 0) throw new Error('empty');
          location.reload();
        } catch {
          status.textContent = 'That file could not be imported. Choose a file made with Export my inputs.';
        }
        file.value = '';
      });
    </script>
  </body>
</html>
