---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LinkList from '../components/LinkList.astro';
import { tools } from '../lib/tools';
import { calculators } from '../lib/calculators';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Hobo Finance" description="Free investing tools, calculators and guides for people in Singapore.">
  <div class="wrap page-head">
    <h1 class="home-title">Hobo Finance</h1>
    <p class="lede">Free investing tools, calculators and guides for people in Singapore.</p>
  </div>

  {
    tools.some((t) => t.ready) && (
      <section class="wrap">
        <h2>Tools</h2>
        <LinkList items={tools.filter((t) => t.ready).map((t) => ({ href: `/tools/${t.slug}/`, title: t.title, blurb: t.blurb }))} />
      </section>
    )
  }

  <section class="wrap">
    <h2>Basic calculators</h2>
    <LinkList items={calculators.map((c) => ({ href: `/calculators/${c.slug}/`, title: c.title, blurb: c.blurb }))} />
  </section>

  {
    posts.length > 0 && (
      <section class="wrap">
        <h2>Latest posts</h2>
        <LinkList items={posts.map((p) => ({ href: `/blog/${p.id}/`, title: p.data.title, blurb: `${date(p.data.pubDate)}. ${p.data.description}` }))} />
        <p style="margin-top:1rem">
          <a href="/blog/">All posts</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .home-title {
    font-size: var(--step-3);
  }
  section h2 {
    font-size: var(--step-2);
  }
  section {
    padding-block: 2.5rem 0 !important;
  }
</style>
