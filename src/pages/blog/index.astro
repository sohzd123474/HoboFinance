---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Blog" description="Plain-language guides to saving, borrowing and investing.">
  <div class="wrap page-head">
    <h1>Blog</h1>
    <p class="lede">Plain-language guides to saving, borrowing and investing.</p>
    {
      posts.length === 0 ? (
        <p style="margin-top:2rem">No posts yet. Try the <a href="/calculators/">calculators</a> in the meantime.</p>
      ) : (
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <p>{p.data.description}</p>
              <time datetime={p.data.pubDate.toISOString()}>{date(p.data.pubDate)}</time>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
