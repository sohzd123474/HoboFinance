---
import Base from '../../layouts/Base.astro';
import Ilp from '../../components/ilp/Ilp.tsx';
---

<Base
  title="ILP vs DIY calculator"
  description="Compare a regular-premium investment-linked policy with buying a world index fund yourself, over 30 years, with every charge and bonus editable."
>
  <div class="wrap page-head">
    <h1>ILP vs DIY calculator</h1>
    <p class="lede">
      Enter a premium to compare an investment-linked policy with buying a world index fund (VWRA) yourself over 30
      years.
    </p>
  </div>

  <div class="wrap">
    <Ilp client:only="react">
      <p slot="fallback" style="margin-top:2rem">Loading the calculator…</p>
    </Ilp>
  </div>
</Base>
